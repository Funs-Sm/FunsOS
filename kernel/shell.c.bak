    } else if (strcmp(line, "fallocate") == 0) {













        cmd_fallocate(arg);













    } else if (strcmp(line, "filefrag") == 0) {













        cmd_filefrag(arg);













    }













    /* New file commands */













    else if (strcmp(line, "cat") == 0) {













        cmd_cat(arg);













    } else if (strcmp(line, "ls") == 0) {













        cmd_ls(arg);













