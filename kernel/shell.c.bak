    else if (strcmp(line, "bios") == 0) {













        shell_last_exit_code = bios_edit_cmd(arg);













    }













    /* New utility commands */













    else if (strcmp(line, "calc") == 0) {













        if (arg && *arg) {













            cmd_calc(arg);  /* 带参数: 直接计算表达式 */













