    } else if (strcmp(line, "column") == 0) {













        cmd_column(arg);













    } else if (strcmp(line, "look") == 0) {













        cmd_look(arg);













    } else if (strcmp(line, "comm") == 0) {













        cmd_comm(arg);













    } else if (strcmp(line, "tsort") == 0) {













        cmd_tsort(arg);













    } else if (strcmp(line, "grep") == 0) {













        if (arg && *arg == '-') {













            cmd_grep(arg);













        } else {













